# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for development. In Vercel, set these per environment:
# Production = live PayPal, Preview = sandbox PayPal.
# Anything without NEXT_PUBLIC_ is server-only and never reaches the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security; used by API routes.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
# S3 API endpoint (R2 → Overview → "S3 API"). Alternatively set R2_ACCOUNT_ID
# (NEXT_PUBLIC_R2_ACCOUNT_ID, the older name, also works).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# An R2 API token with Object Read & Write on BOTH buckets below.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public bucket: tagged preview MP3s + cover art, served at PUBLIC_R2_URL.
R2_PUBLIC_BUCKET=beat-previews
# Private bucket: untagged MP3s, WAVs, stems. No public access; buyers get
# 24-hour presigned links from /api/downloads.
R2_PRIVATE_BUCKET=beat-audio
# Custom domain of the PUBLIC bucket. Stored in the database for previews/covers.
PUBLIC_R2_URL=https://cdn.antonboss.com
# Same domain, for the browser's preconnect hint. Must be the public bucket.
NEXT_PUBLIC_R2_URL=https://cdn.antonboss.com

# ── PayPal ───────────────────────────────────────────────────────────────────
# Required, explicitly: sandbox | live. (No longer inferred from NODE_ENV,
# which is "production" on Vercel previews too.)
PAYPAL_ENV=sandbox
# REST app credentials for that environment (developer.paypal.com → Apps & Credentials).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Same client id, for the PayPal buttons in the browser.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# ID of the webhook pointing at https://<site>/api/paypal/webhook, from the same app.
PAYPAL_WEBHOOK_ID=

# ── Optional ─────────────────────────────────────────────────────────────────
# Set to 1 once the public bucket's CORS allows GET from the site, to stream
# previews directly instead of through /api/audio-proxy.
NEXT_PUBLIC_AUDIO_CORS=
